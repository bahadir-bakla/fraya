# Copy to vendor/MiroFish/.env only when configuring MiroFish.
# Empty keys deliberately fail the upstream launcher. Do not use fake keys.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
ZEP_API_KEY=
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=False
# ZEP_API_URL is unsupported: upstream uses Zep Cloud.
# Optional LLM_BOOST_* settings should be absent unless actually configured.
