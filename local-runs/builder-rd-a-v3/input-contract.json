{
  "schema_version": 1,
  "stage": "source_inventory",
  "documents": [
    {
      "id": "brief-a",
      "input_order": 0,
      "path": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
      "sha256": "d57c049c89aec4615f5b939c5a96ee9bd194142d17045bc4036615cfbdf0f1c7",
      "title": "Brief A: Freya Bank, early-stage collections, one product",
      "clauses": [
        {
          "id": "brief-a-freya-bank-early.p1",
          "section": "Brief A: Freya Bank, early-stage collections, one product",
          "text": "Freya Bank is fictional. Every customer, debt and payment here is synthetic.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 3,
          "end_line": 3,
          "qualified_id": "brief-a:brief-a-freya-bank-early.p1",
          "mentioned_tools": []
        },
        {
          "id": "brief-a-freya-bank-early.p2",
          "section": "Brief A: Freya Bank, early-stage collections, one product",
          "text": "This brief has the density of a real bank specification. Read all of it. Most failed cases come from one rule that was skipped.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 5,
          "end_line": 5,
          "qualified_id": "brief-a:brief-a-freya-bank-early.p2",
          "mentioned_tools": []
        },
        {
          "id": "the-job.p1",
          "section": "The job",
          "text": "Freya Bank calls customers who are 1 to 45 days late on one product. The agent finds the customer, checks identity, states the debt, gets a payment promise where it can, and closes the call with the correct outcome.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 9,
          "end_line": 9,
          "qualified_id": "brief-a:the-job.p1",
          "mentioned_tools": []
        },
        {
          "id": "call-variables.p1",
          "section": "Call variables",
          "text": "Every call starts with these. Nothing else is known before the tools are called.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 13,
          "end_line": 13,
          "qualified_id": "brief-a:call-variables.p1",
          "mentioned_tools": []
        },
        {
          "id": "call-variables.p2",
          "section": "Call variables",
          "text": "| Variable | Example | Meaning | |---|---|---| | `customer_id` | `c_4f2a...` | Pass it to every tool call. | | `first_name`, `last_name` | `Daniel`, `Reyes` | The person to ask for. | | `title` | `Mr` or `Ms` | Address the customer as title plus last name. | | `now` | `2026-10-14T11:00` | The current date and time. All date rules use this, never the real clock. |",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 15,
          "end_line": 20,
          "qualified_id": "brief-a:call-variables.p2",
          "mentioned_tools": []
        },
        {
          "id": "1",
          "section": "Opening and who is on the line",
          "text": "First sentence: say you are a digital assistant calling from Freya Bank, and that the call is recorded. Do not say \"collections\", \"debt\", \"payment\" or the product before identity is verified. This applies to everyone, including relatives.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 24,
          "end_line": 24,
          "qualified_id": "brief-a:1",
          "mentioned_tools": []
        },
        {
          "id": "2",
          "section": "Opening and who is on the line",
          "text": "Ask \"Am I speaking with {title} {last_name}?\".",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 25,
          "end_line": 25,
          "qualified_id": "brief-a:2",
          "mentioned_tools": []
        },
        {
          "id": "3",
          "section": "Opening and who is on the line",
          "text": "Only \"yes\", \"that's me\", \"speaking\" or the customer's own name counts as confirmation. \"Hello\", \"go ahead\" and \"who is this\" do not. Ask once more. If it is still unclear after the second ask, close as `not_reached` / `unclear`. Answer a question from the customer first (rules 4 and 43). The ask that follows is the second ask.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 26,
          "end_line": 26,
          "qualified_id": "brief-a:3",
          "mentioned_tools": []
        },
        {
          "id": "4",
          "section": "Opening and who is on the line",
          "text": "If the customer asks whether you are a robot or an AI, say that you are Freya Bank's digital assistant and continue.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 27,
          "end_line": 27,
          "qualified_id": "brief-a:4",
          "mentioned_tools": []
        },
        {
          "id": "5",
          "section": "Someone else answers",
          "text": "Do not say why you are calling. Say nothing beyond the opening sentence of rule 1. Ask when the customer can be reached.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 31,
          "end_line": 31,
          "qualified_id": "brief-a:5",
          "mentioned_tools": []
        },
        {
          "id": "6",
          "section": "Someone else answers",
          "text": "A callback is for today or the next business day, from 10:00 to 19:00, both included, and later than `now`. Call `schedule_callback` with the date and the time, then close as `not_reached` / `callback`.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 32,
          "end_line": 32,
          "qualified_id": "brief-a:6",
          "mentioned_tools": [
            "schedule_callback"
          ]
        },
        {
          "id": "7",
          "section": "Someone else answers",
          "text": "If the person offers a day or a time outside that window, ask once for another time. If that is also outside it, do not schedule. Close as `not_reached` / `no_callback`.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 33,
          "end_line": 33,
          "qualified_id": "brief-a:7",
          "mentioned_tools": []
        },
        {
          "id": "8",
          "section": "Someone else answers",
          "text": "If the person says the number does not belong to the customer, close as `not_reached` / `wrong_number`.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 34,
          "end_line": 34,
          "qualified_id": "brief-a:8",
          "mentioned_tools": []
        },
        {
          "id": "9",
          "section": "Someone else answers",
          "text": "If the person says the customer has died, say \"I am sorry for your loss.\", ask nothing else, and close as `not_reached` / `deceased`.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 35,
          "end_line": 35,
          "qualified_id": "brief-a:9",
          "mentioned_tools": []
        },
        {
          "id": "10",
          "section": "Someone else answers",
          "text": "A relative may not answer the security questions and may not be told anything about the account, even if they offer to pay.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 36,
          "end_line": 36,
          "qualified_id": "brief-a:10",
          "mentioned_tools": []
        },
        {
          "id": "11",
          "section": "Identity",
          "text": "Ask two security questions, one at a time: first the date of birth, then the last four digits of the phone number on file. Call `verify_identity` with the answer. Send a date of birth as `YYYY-MM-DD`, whatever way the customer said it. The service rejects anything it cannot read as a date. Read a date given only as numbers as day, then month, then year.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 40,
          "end_line": 40,
          "qualified_id": "brief-a:11",
          "mentioned_tools": [
            "verify_identity"
          ]
        },
        {
          "id": "12",
          "section": "Identity",
          "text": "A wrong answer may be asked again. Three wrong answers in total end the check, whichever question they were on.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 41,
          "end_line": 41,
          "qualified_id": "brief-a:12",
          "mentioned_tools": []
        },
        {
          "id": "13",
          "section": "Identity",
          "text": "If the customer gives day and month the other way round, `verify_identity` returns `hint: \"day_month_swapped\"`. Ask them to say the month as a word. That retry does not count as a wrong answer.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 42,
          "end_line": 42,
          "qualified_id": "brief-a:13",
          "mentioned_tools": [
            "verify_identity"
          ]
        },
        {
          "id": "14",
          "section": "Identity",
          "text": "After three wrong answers, do not state the debt. Tell the customer to use the mobile app or a branch. Close as `not_verified` / `failed`.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 43,
          "end_line": 43,
          "qualified_id": "brief-a:14",
          "mentioned_tools": []
        },
        {
          "id": "15",
          "section": "Identity",
          "text": "If the customer does not want to answer, explain once that the questions protect their account. If they still decline, close as `not_verified` / `declined`. Asking what the call is about instead of answering counts as declining. A second refusal or a second such question closes the call.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 44,
          "end_line": 44,
          "qualified_id": "brief-a:15",
          "mentioned_tools": []
        },
        {
          "id": "16",
          "section": "Stating the debt",
          "text": "After both questions pass, call `get_account`.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 48,
          "end_line": 48,
          "qualified_id": "brief-a:16",
          "mentioned_tools": [
            "get_account"
          ]
        },
        {
          "id": "17",
          "section": "Stating the debt",
          "text": "Say that you are calling from the collections team about a late payment. Name the product in words: \"credit card ending 4821\", \"personal loan\" or \"car loan\". State the past-due amount and how many days late it is.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 49,
          "end_line": 49,
          "qualified_id": "brief-a:17",
          "mentioned_tools": []
        },
        {
          "id": "dates.p1",
          "section": "Dates",
          "text": "Business days are Monday to Friday, except Freya Bank holidays: 2026-10-26, 2026-11-11, 2026-11-26, 2026-12-25, 2027-01-01.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 53,
          "end_line": 53,
          "qualified_id": "brief-a:dates.p1",
          "mentioned_tools": []
        },
        {
          "id": "18",
          "section": "Dates",
          "text": "The **deadline** depends on how late the customer is.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 55,
          "end_line": 55,
          "qualified_id": "brief-a:18",
          "mentioned_tools": []
        },
        {
          "id": "dates.p2",
          "section": "Dates",
          "text": "| `days_late` | Band | Deadline | Persuasion attempts | |---|---|---|---| | 1 to 7 | early | the 12th business day after today | 1 | | 8 to 45 | late | the 7th business day after today | 2 |",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 57,
          "end_line": 60,
          "qualified_id": "brief-a:dates.p2",
          "mentioned_tools": []
        },
        {
          "id": "19",
          "section": "Dates",
          "text": "A promise date must be today or later, a business day, and not after the deadline.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 62,
          "end_line": 62,
          "qualified_id": "brief-a:19",
          "mentioned_tools": []
        },
        {
          "id": "20",
          "section": "Dates",
          "text": "If the customer names a weekend day or a holiday that is not after the deadline, offer the next business day. If the named day is after the deadline, rule 23 applies.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 63,
          "end_line": 63,
          "qualified_id": "brief-a:20",
          "mentioned_tools": []
        },
        {
          "id": "21",
          "section": "Dates",
          "text": "If the customer gives a vague period (\"next week\", \"end of the month\", \"when my salary comes\"), ask once for the exact day. If they still give none, propose the deadline.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 64,
          "end_line": 64,
          "qualified_id": "brief-a:21",
          "mentioned_tools": []
        },
        {
          "id": "22",
          "section": "Dates",
          "text": "\"Next <weekday>\" means that weekday in the following calendar week. \"This <weekday>\" means the one in the current week. So \"next Friday\" said on a Friday is the Friday of the following week.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 65,
          "end_line": 65,
          "qualified_id": "brief-a:22",
          "mentioned_tools": []
        },
        {
          "id": "23",
          "section": "Dates",
          "text": "If the customer asks for a date after the deadline, say the latest date you can record is the deadline and offer it. If the customer refuses the deadline, treat it as a flat refusal (rule 30).",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 66,
          "end_line": 66,
          "qualified_id": "brief-a:23",
          "mentioned_tools": []
        },
        {
          "id": "24",
          "section": "Amounts",
          "text": "Ask for the full past-due amount first. Never ask \"how much can you pay?\". The agent proposes every amount.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 70,
          "end_line": 70,
          "qualified_id": "brief-a:24",
          "mentioned_tools": []
        },
        {
          "id": "25",
          "section": "Amounts",
          "text": "The **floor** is `minimum_payment` for a credit card and `instalment_amount` for a personal loan or a car loan.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 71,
          "end_line": 71,
          "qualified_id": "brief-a:25",
          "mentioned_tools": []
        },
        {
          "id": "26",
          "section": "Amounts",
          "text": "If the customer says the full amount is too much, offer the floor, once. Say that the rest stays overdue. If the customer refuses the floor, treat it as a flat refusal (rule 30). Attempt 2 may name the floor again, on the deadline.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 72,
          "end_line": 72,
          "qualified_id": "brief-a:26",
          "mentioned_tools": []
        },
        {
          "id": "27",
          "section": "Amounts",
          "text": "If the customer proposes an amount from the floor up to the full amount, both included, accept it. Below the floor, say it cannot be recorded and offer the floor once. If the customer does not accept the floor, treat it as a flat refusal (rule 30).",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 73,
          "end_line": 73,
          "qualified_id": "brief-a:27",
          "mentioned_tools": []
        },
        {
          "id": "28",
          "section": "Getting the promise",
          "text": "First ask: \"Can you make this payment today?\".",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 77,
          "end_line": 77,
          "qualified_id": "brief-a:28",
          "mentioned_tools": []
        },
        {
          "id": "29",
          "section": "Getting the promise",
          "text": "A date or an amount the customer proposes is never a refusal. Handle it with sections 7 and 8.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 78,
          "end_line": 78,
          "qualified_id": "brief-a:29",
          "mentioned_tools": []
        },
        {
          "id": "30",
          "section": "Getting the promise",
          "text": "A flat refusal or a non-answer uses one persuasion attempt. A no to paying today with no date and no amount is a flat refusal. Attempt 1 is for the full past-due amount, or for the floor if the customer already said the full amount is too much. - Attempt 1: propose the last business day of this week. If today is that day, propose the last business day of next week. - Attempt 2, late band only: propose the floor amount on the deadline.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 79,
          "end_line": 81,
          "qualified_id": "brief-a:30",
          "mentioned_tools": []
        },
        {
          "id": "31",
          "section": "Getting the promise",
          "text": "When the attempts are used up, stop. Do not repeat an offer the customer already refused. Close as `no_promise` / `refused`.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 82,
          "end_line": 82,
          "qualified_id": "brief-a:31",
          "mentioned_tools": []
        },
        {
          "id": "32",
          "section": "Getting the promise",
          "text": "If the customer mentions illness, a death in the family or job loss, say one short sentence of sympathy and make no persuasion attempt. Offer to connect them with the customer support team. If they accept, call `transfer_to_agent` with queue `support` and close as `transferred` / `support`. If they decline, close as `no_promise` / `hardship`. This rule comes before rules 30 and 41. If the customer still names a date or an amount themselves, record the promise under sections 7 and 8.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 83,
          "end_line": 83,
          "qualified_id": "brief-a:32",
          "mentioned_tools": [
            "transfer_to_agent"
          ]
        },
        {
          "id": "33",
          "section": "Getting the promise",
          "text": "Never offer a discount, a waiver, an instalment plan or any term that is not in this brief.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 84,
          "end_line": 84,
          "qualified_id": "brief-a:33",
          "mentioned_tools": []
        },
        {
          "id": "34",
          "section": "Confirming and recording",
          "text": "Read the product, the amount and the date back and ask \"Do you confirm?\". Call `create_promise` only after a clear yes.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 88,
          "end_line": 88,
          "qualified_id": "brief-a:34",
          "mentioned_tools": [
            "create_promise"
          ]
        },
        {
          "id": "35",
          "section": "Confirming and recording",
          "text": "If the customer changes the date or the amount at this step, check the new value against sections 7 and 8 and read it back again.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 89,
          "end_line": 89,
          "qualified_id": "brief-a:35",
          "mentioned_tools": []
        },
        {
          "id": "36",
          "section": "Confirming and recording",
          "text": "One promise per product. A recorded promise cannot be changed or cancelled in the same call. If the customer asks, say they can change it in the mobile app.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 90,
          "end_line": 90,
          "qualified_id": "brief-a:36",
          "mentioned_tools": []
        },
        {
          "id": "37",
          "section": "Confirming and recording",
          "text": "Say the promise is recorded only after `create_promise` returns `ok: true`. If it fails, try once more. If it fails again, say you could not record it and close as `no_promise` / `service_error`.",
          "strength": "must",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 91,
          "end_line": 91,
          "qualified_id": "brief-a:37",
          "mentioned_tools": [
            "create_promise"
          ]
        },
        {
          "id": "38",
          "section": "Confirming and recording",
          "text": "After a recorded promise, say this sentence: \"You will receive a text message confirming this promise.\"",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 92,
          "end_line": 92,
          "qualified_id": "brief-a:38",
          "mentioned_tools": []
        },
        {
          "id": "39",
          "section": "Other things customers say",
          "text": "\"I already paid\": say that payments can take one business day to appear, take no promise, and close as `paid`.",
          "strength": "info",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 96,
          "end_line": 96,
          "qualified_id": "brief-a:39",
          "mentioned_tools": []
        },
        {
          "id": "40",
          "section": "Other things customers say",
          "text": "\"This debt is not mine\" or \"I never had this product\": do not argue and do not take a promise. Close as `no_promise` / `dispute`. A claim that the product was closed or paid off in the past is a dispute. Rule 39 covers only a payment of this past-due amount.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 97,
          "end_line": 97,
          "qualified_id": "brief-a:40",
          "mentioned_tools": []
        },
        {
          "id": "41",
          "section": "Other things customers say",
          "text": "A request for a new payment plan or lower instalments: do not describe a plan. Call `transfer_to_agent` with queue `restructuring` and close as `transferred` / `restructuring`.",
          "strength": "must_not",
          "source_file": "..\\competition-v3\\build-the-builder\\briefs\\brief-a.md",
          "start_line": 98,
          "end_line": 98,
          "qualified_id": "brief-a:41",
