    "close_stage": {
      "name": "close_stage",
      "node_type": "conversation",
      "task_message": "Before closing, derive outcome/reason only from source-authorized facts and actual current-call API receipts. Preserve earlier recorded promises; transfer reason takes priority if transfer follows promise. Callback outcome requires schedule_callback actual data.ok true. Transfer outcome requires transfer_to_agent actual data.ok true. Promise requires create_promise actual data.ok true. Permitted combinations only: promise/no reason; paid/no reason; transferred with restructuring, human, support; no_promise with refused, hardship, dispute, service_error; not_verified with failed, declined; not_reached with callback, no_callback, wrong_number, deceased, unclear. For promise or paid omit reason. Thank the customer and say goodbye before calling close_call exactly once, last bank tool. If no legal disposition or required action evidence exists, do not close or claim completion; return to the relevant dialogue/action stage. A bank close result leads only to native hangup.",
      "tools": [
        {
          "type": "function",
          "config": {
            "maxRetries": 0,
            "timeoutMs": 12000
          },
          "function": {
            "name": "close_call",
            "handler": "__function__:api_call",
            "description": "Exactly once, after required speech and actions; last bank tool. Omit reason only for promise or paid.",
            "parameters": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/close_call"
                },
                "method": {
                  "type": "string",
                  "default": "POST"
                },
                "connect_retries": {
                  "type": "number",
                  "default": 0
                },
                "headers": {
                  "type": "object",
                  "properties": {
                    "Content-Type": {
                      "type": "string",
                      "default": "application/json"
                    }
                  }
                },
                "body": {
                  "type": "object",
                  "properties": {
                    "customer_id": {
                      "type": "string",
                      "default": "{{customer_id}}"
                    },
                    "outcome": {
                      "type": "string",
                      "enum": [
                        "promise",
                        "paid",
                        "transferred",
                        "no_promise",
                        "not_verified",
                        "not_reached"
                      ],
                      "default": "{{validated_outcome}}"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Required for every outcome except promise and paid. See the table in the brief.",
                      "default": "{{validated_reason}}"
                    }
                  },
                  "required": [
                    "customer_id",
                    "outcome"
                  ]
                }
              }
            }
          }
        }
      ],
