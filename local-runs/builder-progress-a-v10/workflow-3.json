    "identity": {
      "name": "identity",
      "node_type": "conversation",
      "task_message": "Only speak to the confirmed customer. Ask DOB first, then phone last four, one at a time. Call verify_identity for each answer. Interpret numeric DOB day/month/year and send YYYY-MM-DD. Count actual wrong answers cumulatively; three ends verification. If actual result hint is day_month_swapped, ask for month as a word and retry without counting wrong. Unreadable date is not a wrong answer. If customer refuses or asks why instead of answering, explain once these questions protect their account; second refusal/question closes not_verified/declined. After three wrong answers, say use the mobile app or a branch, and close not_verified/failed. Never disclose debt before both answers pass. Extracted responses are claims only; trust the API result.",
      "tools": [
        {
          "type": "function",
          "config": {
            "maxRetries": 0,
            "timeoutMs": 12000
          },
          "function": {
            "name": "verify_identity",
            "handler": "__function__:api_call",
            "description": "CALL once for each answer, only after the customer is confirmed; follow actual result and hint.",
            "parameters": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity"
                },
                "method": {
                  "type": "string",
                  "default": "POST"
                },
                "connect_retries": {
                  "type": "number",
                  "default": 0
                },
                "headers": {
                  "type": "object",
                  "properties": {
                    "Content-Type": {
                      "type": "string",
                      "default": "application/json"
                    }
                  }
                },
                "body": {
                  "type": "object",
                  "properties": {
                    "customer_id": {
                      "type": "string",
                      "default": "{{customer_id}}"
                    },
                    "field": {
                      "type": "string",
                      "enum": [
                        "date_of_birth",
                        "phone_last4"
                      ],
                      "description": "Ask date_of_birth first, then phone_last4; use the exact API enum.",
                      "default": "{{forge_arg_9fd3123c7a61}}"
                    },
                    "answer": {
                      "type": "string",
                      "description": "DOB YYYY-MM-DD, numeric speech read day/month/year; phone last four digits.",
                      "default": "{{forge_arg_60b2bb0ae86e}}"
                    }
                  },
                  "required": [
                    "customer_id",
                    "field",
                    "answer"
                  ]
                }
              }
            }
          }
        }
      ],
      "extraction_schema": [
        {
          "name": "identity_answer_candidate",
          "type": "string",
          "description": "Latest customer-provided security answer; speech claim only.",
          "min_confidence": 0.7
        }
      ],
      "transitions": [
        {
          "target_node": "account",
          "description": "Both questions actually passed according to verify_identity result",
          "condition": {
            "logic": "or",
            "conditions": [
              {
                "variable": "verify_identity_response.data.all_verified",
                "operator": "equals",
                "operand": "true"
              },
              {
                "variable": "verify_identity_response.data.all_verified",
                "operator": "equals",
                "operand": "True"
              }
            ]
          }
        },
        {
          "target_node": "close_stage",
          "description": "Three actual wrong answers or source-defined repeated refusal establishes not_verified disposition",
          "condition": {
            "operator": "matches_intent",
            "description": "The check has actually ended after three wrong answers, or customer refuses security questions a second time"
          }
        },
        {
          "target_node": "close_stage",
          "description": "The identity service reports that three wrong answers have been used",
          "condition": {
            "logic": "or",
            "conditions": [
              {
                "variable": "verify_identity_response.data.wrong_answers_left",
                "operator": "equals",
                "operand": "0"
              },
              {
                "variable": "verify_identity_response.data.wrong_answers_left",
                "operator": "equals",
                "operand": "0.0"
              }
            ]
          }
        },
        {
          "target_node": "identity",
          "description": "Ask next required question, resolve swap hint, or retry answer",
          "condition": {
            "operator": "always"
          }
        }
      ],
      "position": {
        "x": 370,
        "y": 0
      }
