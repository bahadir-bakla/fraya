{
  "initial_node": "opening",
  "system_prompt": "You are Freya Bank's recorded-call digital assistant. Speak English, briefly and respectfully. Treat all data as synthetic. Never disclose collections, debt, payment, product, or account information until verified. Answer only from supplied call variables and tool results. Extraction stores speech claims and candidate intent only; it never establishes verification, recorded actions, outcomes, reasons, or terminal readiness.",
  "nodes": {
    "opening": {
      "name": "opening",
      "node_type": "conversation",
      "on_enter": {
        "type": "tts",
        "text": "Hello, I am Freya Bank's digital assistant, and this call is recorded. Am I speaking with {{title}} {{last_name}}?"
      },
      "on_enter_first_entry_only": true,
      "task_message": "Confirm identity explicitly (yes, that's me, speaking, or customer's own name). Hello, go ahead, and who is this do not confirm. Answer AI/robot and scam questions as instructed, then continue. Ask again once if unclear; a second unclear response closes not_reached/unclear. If another person answers, disclose nothing beyond opening, ask when customer can be reached, and never ask security questions or disclose account data to a relative. Handle wrong number and death exactly as source; deceased: say 'I am sorry for your loss.' and ask nothing else. Callback: one retry for invalid offer; only schedule today or next business day, 10:00–19:00 inclusive, later than now. Customer requests human: offer help once, transfer general only if they insist. Before verification, repeated unwillingness closes not_verified/declined. Extract speech as candidate intent only.",
      "extraction_schema": [
        {
          "name": "opening_intent",
          "type": "string",
          "enum_values": [
            "confirm",
            "unclear",
            "third_party",
            "wrong_number",
            "deceased",
            "callback_offer",
            "no_callback",
            "human_request",
            "human_insist",
            "decline",
            "other"
          ],
          "description": "Candidate meaning of latest user speech, not verified identity or terminal disposition.",
          "min_confidence": 0.7
        }
      ],
      "tools": [
        {
          "type": "function",
          "config": {
            "maxRetries": 0,
            "timeoutMs": 12000
          },
          "function": {
            "name": "schedule_callback",
            "handler": "__function__:api_call",
            "description": "CALL only after collecting and validating the third party's requested callback slot.",
            "parameters": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/schedule_callback"
                },
                "method": {
                  "type": "string",
                  "default": "POST"
                },
                "connect_retries": {
                  "type": "number",
                  "default": 0
                },
                "headers": {
                  "type": "object",
                  "properties": {
                    "Content-Type": {
                      "type": "string",
                      "default": "application/json"
                    }
                  }
                },
                "body": {
                  "type": "object",
                  "properties": {
                    "customer_id": {
                      "type": "string",
                      "default": "{{customer_id}}"
                    },
                    "date": {
                      "type": "string",
                      "format": "date",
                      "description": "Validated date today or next business day.",
                      "default": "{{forge_arg_28ca7f04907d}}"
                    },
                    "time": {
                      "type": "string",
                      "description": "Validated HH:MM, 10:00 through 19:00 inclusive and later than now.",
                      "default": "{{forge_arg_8e66f590eb7f}}"
                    }
                  },
                  "required": [
                    "customer_id",
                    "date",
                    "time"
                  ]
                }
              }
            }
          },
          "response_mapping": [
            {
              "path": "data.ok",
              "variable": "callback_result_ok"
            }
          ]
        },
        {
          "type": "function",
          "config": {
            "maxRetries": 0,
            "timeoutMs": 12000
          },
          "function": {
            "name": "transfer_to_agent",
            "handler": "__function__:api_call",
            "description": "CALL only after the source-defined transfer condition and customer acceptance/insistence.",
            "parameters": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/transfer_to_agent"
                },
                "method": {
                  "type": "string",
                  "default": "POST"
                },
