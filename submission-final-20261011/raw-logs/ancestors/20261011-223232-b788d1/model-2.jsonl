  }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    },\r\n    \"securitySchemes\": {\r\n      \"bearerAuth\": {\r\n        \"type\": \"http\",\r\n        \"scheme\": \"bearer\",\r\n        \"description\": \"Production gateway token from POST /oauth2/token; test mock does not validate tokens or headers.\"\r\n      }\r\n    }\r\n  },\r\n  \"x-source-contract\": \"final-case-20261011/Build the Builder - Final Case/sources/documents/2026-10-01-service-contract.md\",\r\n  \"x-source-fixtures\": \"final-case-20261011/Build the Builder - Final Case/test-environment/test-customers.json\",\r\n  \"x-source-fixtures-sha256\": \"d6ce155638f61ab17910d53ea993a2b0d68cf4e10d6b9db2fb8e4a7add0ef44d\"\r\n}\r\n{\r\n \"nodes\": {\r\n  \"identity\": {\r\n   \"name\": \"identity\",\r\n   \"tools\": [\r\n    {\r\n     \"type\": \"function\",\r\n     \"config\": {\r\n      \"timeoutMs\": 12000,\r\n      \"maxRetries\": 0\r\n     },\r\n     \"function\": {\r\n      \"name\": \"verify_identity\",\r\n      \"handler\": \"__function__:api_call\",\r\n      \"parameters\": {\r\n       \"type\": \"object\",\r\n       \"properties\": {\r\n        \"url\": {\r\n         \"type\": \"string\",\r\n         \"default\": \"https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity\"\r\n        },\r\n        \"body\": {\r\n         \"type\": \"object\",\r\n         \"required\": [\r\n          \"field\",\r\n          \"answer\"\r\n         ],\r\n         \"properties\": {\r\n          \"field\": {\r\n           \"enum\": [\r\n            \"date_of_birth\",\r\n            \"phone_last4\"\r\n           ],\r\n           \"type\": \"string\",\r\n           \"default\": \"{{field}}\",\r\n           \"description\": \"Which answer this is.\"\r\n          },\r\n          \"answer\": {\r\n           \"type\": \"string\",\r\n           \"default\": \"{{answer}}\",\r\n           \"description\": \"date_of_birth as YYYY-MM-DD, phone_last4 as four digits.\"\r\n          },\r\n          \"customer_id\": {\r\n           \"type\": \"string\",\r\n           \"default\": \"{{customer_id}}\"\r\n          }\r\n         }\r\n        },\r\n        \"method\": {\r\n         \"type\": \"string\",\r\n         \"default\": \"POST\"\r\n        },\r\n        \"headers\": {\r\n         \"type\": \"object\",\r\n         \"properties\": {\r\n          \"Content-Type\": {\r\n           \"type\": \"string\",\r\n           \"default\": \"application/json\"\r\n          }\r\n         }\r\n        }\r\n       }\r\n      },\r\n      \"description\": \"Check one security answer. Call it once for each answer the customer gives.\"\r\n     }\r\n    },\r\n    {\r\n     \"type\": \"function\",\r\n     \"config\": {\r\n      \"timeoutMs\": 10000\r\n     },\r\n     \"function\": {\r\n      \"name\": \"end_call\",\r\n      \"handler\": \"__function__:end_call\",\r\n      \"parameters\": {\r\n       \"type\": \"object\",\r\n       \"properties\": {\r\n        \"message_mode\": {\r\n         \"type\": \"string\",\r\n         \"default\": \"none\"\r\n        },\r\n        \"interruptible\": {\r\n         \"type\": \"boolean\",\r\n         \"default\": true\r\n        },\r\n        \"trigger_pattern\": {\r\n         \"type\": \"string\",\r\n         \"default\": \"Have a good day|have a good day\"\r\n        },\r\n        \"trigger_timeout\": {\r\n         \"type\": \"number\",\r\n         \"default\": 3\r\n        },\r\n        \"trigger_pattern_both\": {\r\n         \"type\": \"string\",\r\n         \"default\": \"goodbye|bye|have a good day|you too|thank you|thanks|take care\"\r\n        }\r\n       }\r\n      },\r\n      \"description\": \"Ends the call. You normally do NOT call this: the phrase \\\"Have a good day.\\\" ends the call by itself. Call it without any text only if the customer answers after your goodbye.\"\r\n     }\r\n    }\r\n   ],\r\n   \"on_enter\": {\r\n    \"text\": \"Hello, this is the digital assistant of Freya Bank. Am I speaking with {{title}} {{last_name}}?\",\r\n    \"type\": \"tts\"\r\n   },\r\n   \"position\": {\r\n    \"x\": 498.0464451619148,\r\n    \"y\": -590.6037491300582\r\n   },\r\n   \"node_type\": \"conversation\",\r\n   \"assertions\": [],\r\n   \"passthrough\": false,\r\n   \"pre_actions\": [],\r\n   \"transitions\": [\r\n    {\r\n     \"condition\": {\r\n      \"logic\": \"or\",\r\n      \"conditions\": [\r\n       {\r\n        \"mode\": \"exact\",\r\n        \"operand\": \"true\",\r\n        \"operator\": \"equals\",\r\n        \"variable\": \"verify_identity_response.data.all_verified\"\r\n       },\r\n       {\r\n        \"mode\": \"exact\",\r\n        \"operand\": \"True\",\r\n        \"operator\": \"equals\",\r\n        \"variable\": \"verify_identity_response.data.all_verified\"\r\n       }\r\n      ]\r\n     },\r\n     \"description\": \"both security answers verified\",\r\n     \"target_node\": \"collection\"\r\n    }\r\n   ],\r\n   \"role_message\": \"\",\r\n   \"task_message\": \"You are the digital assistant of Freya Bank. Your only job here is to verify the customer's identity. Speak English, one or two short sentences per turn.\\nOnce the customer confirms who they are, ask for their date of birth, then the last four digits of their phone number, and call verify_identity for each answer.\\nYou do not know why the bank is calling. If asked, say you can explain after the security check.\\nIf the identity check fails, say goodbye, ending with \\\"Have a good day.\\\"\",\r\n   \"interruptible\": false,\r\n   \"max_node_turns\": 80,\r\n   \"response_mapping\": [],\r\n   \"extraction_schema\": [],\r\n   \"max_turn_transition\": null,\r\n   \"truncation_strategy\": \"keep_all\",\r\n   \"suppress_tool_results\": false,\r\n   \"truncation_window_size\": 10,\r\n   \"on_enter_first_entry_only\": false,\r\n   \"disable_inactivity_monitor\": false,\r\n   \"passthrough_default_transition\": null,\r\n   \"return_to_previous_on_interrupt\": false\r\n  },\r\n  \"collection\": {\r\n   \"name\": \