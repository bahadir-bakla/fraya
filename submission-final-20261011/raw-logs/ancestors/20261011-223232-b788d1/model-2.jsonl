_process_code'],{'vars':v,'config':config});check('change-original-day-integer',config['body']['data']['statementDay']==9 and isinstance(config['body']['data']['newStatementWeek'],int))\r\nrun(v,receipt=ok({'responseCode':0,'exitState':'OK','statementDay':'99'}));check('success-preview-dates', '16 Kasım 2026' in v['dialogue_line'] and '26 Kasım 2026' in v['dialogue_line'] and v['route']=='finish')\r\nv=offer();run(v,act('email'));run(v,act('unknown',completion='partial'));run(v,act('yes',raw='Evet.',consent='explicit'));check('malformed-confirm-keeps-readback-and-recovers',v['route']=='statement_pdf_send')\r\nv=offer();run(v,act('out_of_scope'));run(v,act('no'));check('out-of-scope-resumes-exact-phase',v['phase']=='offer')\r\nv=offer();run(v,act('human',completion='partial'));check('partial-human-does-not-transfer',v['route']=='listen');run(v,act('human'));check('complete-human-immediate',v['routing_result']=='AGENT')\r\nfor kind,dest in [('third_party','IVR_LOGIN'),('payment','AGENT'),('dispute','AGENT'),('non_turkish','MAIN_MENU')]:\r\n    v=offer();run(v,act(kind));check('exit-'+kind,v['routing_result']==dest)\r\nv=offer()\r\nfor i in range(3):run(v,act('complaint'));check('calming-'+str(i+1),v['route']=='listen')\r\nrun(v,act('complaint'));check('continued-after-third-to-agent',v['routing_result']=='AGENT')\r\nv=offer()\r\nfor i in range(2):run(v,act('silence'));check('silence-repeat-'+str(i+1),v['route']=='listen')\r\nrun(v,act('silence'));check('silence-third-disconnect',v['routing_result']=='DISCONNECT')\r\nv=offer();line=v['dialogue_line']\r\nfor i in range(5):run(v,act('repeat'))\r\ncheck('repeat-unlimited-not-attempt',v['dialogue_line']==line and json.loads(v['bank_state'])['tries']==0)\r\nv=initial([card,dict(card,cardNumber='5450009876544321')]);check('duplicate-name-selection',v['phase']=='select')\r\nrun(v,act('select',card_reference='Yıldız Premium'));check('duplicate-name-last4',v['phase']=='last4')\r\nrun(v,act('select',card_digits='4321'));check('duplicate-last4-last6',v['phase']=='last6')\r\nrun(v,act('select',card_digits='564321'));check('last6-exact-record-match',v['route']=='cards_balance' and v['selected_card']==card['cardNumber'])\r\nv=initial([card,dict(card,cardNumber='5450009876549876',cardNumberLast4='9876',productName='Yıldız Pratik')]);run(v,act('select',card_reference='Yıldız Premium'));run(v,receipt=ok(balance));check('another-card-before-offer',v['phase']=='another' and v['route']=='listen')\r\nv=initial();b=copy.deepcopy(balance);b['statementDate']='';b['lastPayDate']='';b['statementPaymentStatus']='NO_DEBT';run(v,receipt=ok(b));check('new-card-no-invented-issued-date', 'henüz kesilmiş' in v['dialogue_line'] and '5 Kasım 2026' in v['dialogue_line'] and '5 Ekim' not in v['dialogue_line'])\r\nv=initial();v['now']='2026-10-05T08:00:00+03:00';run(v,receipt=ok(balance));check('cut-day-total-not-statement', '00.00' in json.loads(v['bank_state'])['prefix'] and 'bin yüz' in json.loads(v['bank_state'])['prefix'])\r\nfor remaining_min,label in [(400,'minimum tutar'),(0,'teşekkür'),(200,'kalan minimum')]:\r\n    v=initial();b=copy.deepcopy(balance);b['debtTL']['remainingMinPayment']=remaining_min;run(v,receipt=ok(b));check('TL-'+str(remaining_min),label in json.loads(v['bank_state'])['prefix'])\r\nv=initial();run(v,receipt={'status_code':500,'data':{'result':{'returnCode':'FBE00099'}}});check('real-bank-failure-agent',v['routing_result']=='AGENT')\r\nv={'customerNumber':'90000001','now':'2026-10-12T10:00:00+03:00'};run(v);v['cards_list_response.status_code']=404;v['cards_list_response.data.result.returnCode']='FB_IVR_CHANNEL_102';run(v);check('HTTP-error-without-posthook-warning',v['routing_result']=='MAIN_MENU' and 'uygun' in v['dialogue_line'])\r\ncheck('stale-receipt-cleared',v['bank_receipt']=='' and v['receipt_operation']=='')\r\nenv={'vars':{'customerNumber':'90000001','now':'2026-10-12T10:30:00+03:00'}};exec(code,env,env)\r\nfor mask in itertools.product((0,1),repeat=4):\r\n    if sum(mask) in (0,4):continue\r\n    s=json.loads(offer()['bank_state']);s['balance']=copy.deepcopy(balance)\r\n    for (cc,no_debt) in zip(('TL','USD','EUR','GBP'),mask):s['balance']['debt'+cc]=block(0 if no_debt else 1000)\r\n    s['no_statement_debt']=False\r\n    text=env['debt_reading'](s)\r\n    check('no-debt-combination-'+''.join(map(str,mask)),text.count('borcunuz bulunmamaktadır.')==1)\r\ncheck('no-null-workflow','null' not in json.dumps(w))\r\ncheck('no-agent-config','agent_config' not in w)\r\nfor key,n in w['nodes'].items():\r\n    for t in n.get('transitions',[]):check('edge-'+key+'-'+t['target_node'],t['target_node'] in w['nodes'])\r\n    if n.get('passthrough'):check('fallback-'+key,n['transitions'][-1]['condition']['operator']=='always')\r\n    for tool in n.get('pre_actions',[]):\r\n        for k in ('pre_process_code','post_process_code'):\r\n            if k in tool:compile(tool[k],k,'exec');check('no-templates-'+key+'-'+k,'{{' not in tool[k] and '}}' not in tool[k])\r\n    if n['node_type']=='api_request':check('write-retry-'+key,n['pre_actions'][0]['config']['maxRetries']==0)\r\ncheck('coverage-status-all',all(r.get('rule_id') and r.get('status') and r.get('implementation') for r in p['rules']))\r\npathlib.Path('local_checks.json').write_text(json.dumps({'passed':len(checks),'failed':0,'checks':checks,'scope':'Local controller and generated hooks under persistent merge variables, graph and schema checks. No real extractor or hosted platform observation.'},ensure_ascii=False,indent=2),encoding='utf-8')\r\nprint('Passed',len(checks),'local checks')\r\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Users\\\\9bakl\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content BUILD_INSTRUCTIONS.md | Select-Object -Skip 130 -First 140'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Users\\\\9bakl\\\\.cache\\\\codex-runtimes\\\\codex-primary-runtime\\\\dependencies\\\\native\\\\powershell\\\\pwsh.exe\" -Command 'Get-Content BUILD_INSTRUCTIONS.md | Select-Object -Skip 130 -First 140'","aggregated_output":"Interpret negation and completion in the scope of the actual clause. An affirmative idiom such as \"yes, no problem\" is not a refusal solely because a global regex sees \"no\"; explicit withdrawal, changed terms and unfinished correction still block consent. Validate a complete affirmative against the current readback's exact targets and terms, and never route a blocked or undecodable confirmation through a generic collective refusal that reopens paid or otherwise resolved siblings. Recover by a fresh readback or a clarification of the affected target. An ellipsis in an earlier clause does not mark a complete later sibling unfinished: bind completion evidence to its clause/component. Independently test idiomatic affirmatives, genuine scoped negatives, qualified yes, withdrawn consent, changed date/amount, nonterminal ellipsis and terminal unfinished speech, without weakening malformed-input or identity gates.\r\n\r\n\r\n\r\nAdvertise and consume the same kind set for scalar and compound events in every phase. Agreement with several already spoken counteroffers is acceptance of those exact offers, followed by the required joint readback and a separate confirmation; it is not yet permission to write. The extractor may express the agreement as one scoped event or several agreement clauses. Handle both without dropping targets, inventing terms, or classifying an unsupported speech-event shape as a bank-service outage. Unknown event shapes require bounded clarification and clear stale consent. A qualified yes or a new amount/date that differs from the spoken terms is a correction and invalidates the previous readback. Minimal contract tests must include compound acceptance in the offer phase and compound confirmation in the readback phase, with negative and incomplete controls.\r\n\r\n\r\n\r\nClear consent without losing the last validated terms needed for recovery. Persist the last actually spoken question, operation, target, offer/readback revision and complete terms across code/API invocations. Missing/malformed extraction invalidates authorization, not those facts. If the same complete readback remains the current question and the speech supplies no correction, withdrawal or intervening operation, ask one brief explicit confirmation of that readback within the policy clarification budget; only a later valid phase-bound affirmative may authorize it. If that context is missing or suspended, speak a fresh complete readback first. Never remain in a confirm phase with no active readback and an endless generic clarification. If it contains an unfinished correction, retain unaffected components and ask only for the changed/missing component before the fresh readback. Test a real sequence: valid proposal, spoken readback, null/malformed confirmation event, then a valid confirmation event. Also test null extraction on otherwise clear security replies; use only faithful whole-reply parsing or a bounded phase-specific clarification, never an inferred refusal or a payment/consent guessed from earlier speech. The advertised date grammar must match normalization: a verbatim date phrase cannot be promised if only ISO/explicit-year tokens are implemented without a missing-component clarification.\r\n\r\n\r\n\r\nPreserve each product's existing valid counteroffer when moving between products. Acceptance of a sibling product is not a refusal of this product and must not silently replace its offered date, amount or consume its attempt budget. After a below-floor proposal, state the actual permitted floor and the required residual-overdue warning before seeking its acceptance. Collective acceptance covers only counteroffers actually spoken, then still requires the supplied joint readback and separate confirmation.\r\n\r\n\r\n\r\nApply any supplied residual-overdue warning to every qualifying partial promise, including a voluntary valid amount, an exact floor and a corrected readback. The warning obligation must not live only in the below-floor counteroffer branch. Track that it was actually spoken at the policy's required point; a successful record or text-message notification alone does not satisfy that obligation.\r\n\r\n\r\n\r\nKeep unfinished corrections scoped to their actual target set. An unrelated entity update cannot borrow, complete or clear another entity's fragment. Preserve unrelated valid proposals, but prevent a joint readback/write while an unrecorded correction remains unresolved. Handle incomplete/partial/correction events before phase-specific proposal and consent branches, including hardship/support. A partially spoken amount/date never becomes eligible merely because the current phase changes. Completion requires a new valid proposal, readback and separate consent.\r\n\r\n\r\n\r\nRepresent the unresolved component explicitly in both the extraction contract and persisted proposal state. Separate an unfinished qualification/condition from an unfinished amount or date; a terminal \"if\" after otherwise complete offered terms does not establish an amount correction. Check the producer's component label against its actual source clause before creating a blocking requirement. If unclear, ask what condition or component remains unresolved, preserving offered terms without accepting the condition. A later supported unconditional acceptance of those current terms may supersede the unfinished qualification and proceed to a fresh readback; a date-only answer cannot resolve a genuinely unfinished amount. Test an incorrectly labelled amount fragment followed by complete date/offer acceptance alongside a real cut-off amount followed by date-only speech. The presence of a complete date in an incomplete utterance does not mean that the date is the unfinished component; it may accompany an unfinished amount. Likewise a weekday fragment can be an unfinished date without saying the word date. If the component cannot be determined, clarify which component changed and preserve unaffected validated facts. While an amount is unresolved, a later date-only answer must not silently fill it from the cached full offer, earlier superseded amount, floor or outstanding balance. Resolve that flag only from an explicit completed customer amount or, where the input policy permits it, an unambiguous acceptance of a newly spoken recovery offer for this same target and revision. Such acceptance adopts the exact spoken amount, not a cached full balance or an unrelated floor. Bind recovery-offer eligibility to the currently awaiting offer-acceptance question, target and offer revision; storing a recovery offer alone never makes later agreement refer to it. An explicit completed customer proposal or a newer complete readback supersedes that recovery offer: explicitly clear its active flag and revision in the persistent update store, while retaining unrelated targets. A confirmation of the latest readback must preserve that readback's exact terms and must not first reapply an older recovery amount. Test unfinished amount -> spoken recovery offer -> different complete policy-valid customer amount -> fresh readback of the new terms -> later confirmation; the dispatch must use only the latest readback and never restore the stale offer. A later date-only reply cannot manufacture acceptance of a still-active recovery offer. Fresh complete readback and subsequent confirmation remain required. Test the literal producer grammar through persistent sequences: known amount/date -> unfinished weekday correction; unfinished amount plus complete date -> amount clarification; unfinished amount -> unrelated date-only answer -> still no amount/readback/write -> explicit completed amount -> fresh readback -> later consent. Check retained facts, unresolved flags, actual clarification and absence of writes at every step, rather than only the final outcome.\r\n\r\n\r\n\r\nMultiple unresolved components must support completion across several customer turns. Track which required components have been explicitly completed since this correction began; do not equate a carried cached value with a new completion. An amount answer followed by a date answer, and the reverse order, must resolve a both-components correction just as the same two facts in one complete utterance do. For an unknown correction, first clarify scope or track explicit new completions; once its required facts are genuinely complete, clear the unresolved flags, perform all policy checks and speak a fresh full readback. A later clear confirmation may then authorize the exact terms. Do not demand that the customer repeat all completed facts in the same utterance merely to clear a stale both/unknown flag. Include missing extraction and unrelated updates between the two answers; neither may manufacture completion or discard the first completed fact.\r\n\r\n\r\n\r\nApply completion and correction guards before security verification as well. A partial answer cannot consume a verification attempt or authorize any tool. When repeated fragments make no progress, ask one short question for the actual missing product or component, retaining valid sibling decisions and known spoken terms. Do not demand a new date merely because the customer is still finishing an amount, and do not infer consent to the existing date until the customer's completed answer clearly covers it. Distinguish typed negation from keyword presence: a negated historical-payment phrase must not overwrite a valid positive proposal with a dispute classification.\r\n\r\n\r\n\r\nStore all incomplete proposal components in the same per-target pending structure, whether the customer explicitly stopped mid-sentence or gave a complete amount-only/date-only answer. When a sibling completes, the next question must finish the customer's retained proposal before offering an older counteroffer; do not let a cached floor displace a valid amount awaiting its own date. Assert the next spoken question in interleaved-target contract probes, as well as proving that no values or consent cross target boundaries. If redundant raw text conflicts with a typed proposal, respect scoped negation and clarify real conflicts; a bare paid/closed keyword cannot silently replace the proposal with a terminal disposition.\r\n\r\n\r\n\r\nValidate event structure and target scope before handling its completion state. For a readable incomplete event, classify the declared unfinished component before applying complete-value validation. Retain each independently complete valid component for that same target even when another component is unfinished; a declared unfinished date fragment is neither a usable date nor a reason to discard a complete amount. Update the correction's required set by subtracting explicit newly completed components, rather than unioning obsolete missing flags or reviving superseded offers. Preserve unaffected target facts, invalidate active readback and consent, and clarify only remaining components. Malformed structure or ambiguous scope authorizes no write. Once all required components are complete and policy-valid, speak a fresh full readback and require later clear confirmation. Validate this with the actual delivered event grammar, persistent merged state and next spoken question, including complete amount plus unfinished date and both completion orders.\r\n\r\n\r\n\r\nResolve references to terms actually spoken, rather than treating every omitted scalar as a wholly unknown proposal. Explicit agreement to pay a named product's offered full amount on a newly stated date can refer to that known amount when the supplied policy permits it and no competing amount or unfinished correction exists. Preserve that product while processing sibling refusals, then validate and jointly read back the resulting terms before separate consent. If the reference is ambiguous, ask only for the missing component; do not silently omit the product or borrow an unrelated sibling offer.\r\n\r\n\r\n\r\nCatch invalid calendar construction inside the security parser. An unreadable or impossible date requires the source-prescribed clarification; it is neither an explicit refusal nor a bank-service failure. Raw-speech fallback may fill missing neutral facts, but must not override human-transfer, restructuring, hardship or stop intents using incidental paid/closed keywords. Scope negation to any date token, including weekdays; when raw fallback sees multiple competing amounts or dates, clarify rather than taking its first regex match or spreading a scalar across products. Preserve the source's priority order before any account write or note.\r\n\r\n\r\n\r\nIndependent administrative questions (AI identity, legitimacy or call purpose) must remain pending until their permitted response is spoken, including across a security/API hop. Preserve the primary security/payment facts and never claim an administrative answer was given when it was dropped by routing.\r\n\r\n\r\n\r\n## Platform pattern\r\n\r\n\r\n\r\nResolve the current phase's complete nonpayment intent before applying payment-fragment or malformed-event guards. A third-party answer remains a third-party answer when it also asks the call purpose or offers to pay; answer only what the policy permits, then collect a callback without security or account disclosure. A request for lower instalments or a new payment plan is a restructuring intent, not an unfinished amount. If the supplied policy offers something on hardship (a transfer, a callback, a letter or nothing), offer exactly that; a declined offer finishes that branch without repeating it. Preserve these primary intents and independent administrative questions together in the producer contract, and test complete ordinary utterances containing both rather than requiring one intent per turn. Do not turn an AI-identity question into a request for a human.\r\n\r\n\r\n\r\nNormalize complete ordinary date expressions at the producer/consumer boundary using the call's supplied date context: month names and spoken ordinals, omitted years, weekday plus day ordinal, and the policy's this/next weekday definition. Require a consistent unambiguous whole expression; never infer a date from an unfinished fragment or negate the customer's explicit date by substituting the old offered date. An acceptance of a known offered amount with a newly supplied date adopts that new date before validation and readback. Distinguish a vague period, an unreadable expression and a valid date requiring holiday/deadline adjustment. Use the policy's one exact-day clarification and fallback, rather than asking indefinitely. Preserve unsupported/ambiguous input safeguards and verify both ordinary and contradictory date examples against the actual extraction grammar.\r\n\r\n\r\n\r\nKeep date normalization outcomes explicit: valid exact expression, source-defined vague period, unfinished component, and invalid or conflicting complete expression. Do not silently count impossible dates or contradictory weekday/date pairs as repeated vague periods. Apply fallback and clarification limits only to the classes covered by the supplied source. If the source leaves repeated invalid-input behavior unspecified, record the interpretation; any distinct valid counteroffer still needs its own complete readback and later consent. Audit expectations remain separate from source obligations. Test the boundary independently from business-day, holiday and deadline arithmetic.\r\n\r\n\r\n\r\nSecurity answers may be complete even when accompanied by a call-purpose question. Normalize that current answer, answer only the permitted question, and submit the answer to the authoritative identity tool. End at the source-prescribed total wrong-answer limit across questions, excluding explicit backend day/month-swap retries; do not confuse parser retries with wrong bank answers. The failed-identity farewell must include the actual source-prescribed recovery options. Keep call-recording disclosure distinct from promise-recording acknowledgement: preserve required opening disclosure, while acknowledging a promise only after its own successful write receipt.\r\n\r\n\r\n\r\nRead the supplied workflow-format.md and tools-and-code.md. Follow their verified patterns. Base-agent.json is only a schema example. A lean reliable graph usually separates opening/security, account loading, deterministic account/calendar preparation, collection, and end. Use more nodes only when they provide a real gate. Avoid one code hop per trivial step; every hop costs latency.\r\n\r\n\r\n\r\nOnly identity and pre-identity closing/callback/human-transfer tools may exist before verification. Route to account loading exclusively on a real backend `all_verified` response (or the equivalent this API actually returns). Never extract `verified` from the customer's speech. Third parties cannot answer security questions. Do not place account objects or debt values in the initial prompts or test variables. Opening cannot identify the call as collection, debt or payment unless the supplied policy explicitly permits it. Use the requested dialogue language; do not copy the local demo's Turkish voice when the practice bank is English.\r\n\r\n\r\n\r\nAPI bodies must match the supplied schema including enums and optionality. Fixed backend URL, method, headers and customer_id use `default`; model-filled answers/date/amount stay visible schema properties, without a default on a variable that has not yet been set. `maxRetries=0` on writing tools. Derive retry budgets by operation and documented error class from the input policy and API; a payment retry rule does not grant retries for every other operation. A documented unreadable-input rejection requires corrected input rather than an unchanged resend and is not a failed identity comparison. Distinguish it from a documented service failure where nothing was recorded. Do not invent error-code meanings, bank failures or receipts from a parser failure. Tool-level `response_mapping` belongs beside function/config; pre-action response_mapping belongs on the node. Paths start with `data.`. Booleans from the engine are strings; check true and True or map explicit string flags.\r\n\r\n\r\n\r\nUse the documented `on_enter: {type: silent}` for API/code passthrough nodes. An empty TTS text is not a silent action: actual practice calls stopped immediately after a successful API response when an action node had an empty TTS entry. Preserve the final always fallback and result mappings so the next security question or permitted action actually runs.\r\n\r\n\r\n\r\nUse code nodes to compute all business dates, deadline bands, floors and allowed callback days from `vars['now']` and the API's products. Read mapped arrays defensively as list, JSON string, or flattened keys; derive product_ids only from those records. Holidays and all parameters come from extracted policy. Give the dialogue a compact readable table of finished facts. Never use the host clock. Date phrases next/this weekday must obey the supplied definition; do not let a generic date extractor override it. Preserve vague/partial inputs until the customer completes or clarifies them. Corrections supersede earlier fragments. Ignore incidental dates in small talk.\r\n\r\n\r\n\r\nEvery structured event field consumed by state-machine code must be explicitly required in its extraction schema or have a faithful fallback from raw speech. Inspect the generated code's event.get keys against the actual extractor contract; a security event containing only kind/raw must not silently lose its answer. Provide one local contract round-trip for every event family, using minimal actual schema output rather than hand-populating hidden fields. Never rely on the dialogue model to fill gaps in authoritative bank state. For strict state-driven questions and statuses prefer a computed literal customer-facing sentence in the documented on_enter {type: tts, text: {{dialogue_line}}}. Each user reply can extract an event then route through deterministic code and re-enter the appropriate speech node. A tts string must contain the words to speak, not an imperative instruction. This prevents a freeform dialogue model from replacing a security question or claiming an unrecorded promise.\r\n\r\n\r\n\r\nEach tool result needs an explicit actionable `what_to_do_next` sentence. After every tool result the phone agent must immediately speak or call its next permitted tool; it must never end a turn silently. Post-hooks receive an envelope, API body is result['data']. Hooks can write vars (observed in the kit). Strip headers. Keep flags strings, initialize every referenced state variable. Do not serialize the engine's copied full conversation or repeated code/debug strings as business state. Keep only the authoritative state, needed response facts and small extraction events; repeated metadata can overflow the sandbox output. Actual call traces remain in the engine separately and must remain reviewable.\r\n\r\n\r\n\r\nTreat transport and sandbox execution failures separately from a valid bank response with ok:false. Inspect the documented automatic action failure counters/status fields before reusing a stored route; a failed post-hook can leave the old route unchanged. Avoid self-loops caused solely by that stale route. Provide a bounded, static failure exit that can speak and terminate even when code execution is unavailable; preserve successful writes already confirmed by the bank. Do not silently exceed retry rules. Keep acknowledgement and closing paths short enough for a customer waiting after confirmation; confirmed multi-product writes need factual speech when processing takes several steps, and the final bank close must actually occur before termination.\r\n\r\n\r\n\r\nAn actual HTTP error may skip the response post-hook entirely. Bind the pending dispatched operation to the configured API action's automatic response status, HTTP status code and new failure/success counter observations before treating an empty custom receipt as an unknown timeout. A documented HTTP failure that guarantees nothing was recorded still permits exactly the supplied retry; normalize that observed failure without fabricating a successful receipt. Consume each completion once, keep the original exact request terms and policy retry budget, and reject stale counter/status observations from an earlier dispatch. Unknown transport outcome and sandbox parsing failure remain separate. Exercise the actual graph path with failed-action metadata and NO post-hook execution, as well as ok:false application responses; manually running a post-hook for an HTTP500 is not evidence that the hosted error path retries.\r\n\r\n\r\n\r\nAll snippets must compile, use only json/re/datetime, be wrapped in try/except with safe fallback values, and contain no double-curly template markers (including adjacent nested-dict braces). They run in the platform sandbox, not locally as builder tools.\r\n\r\n\r\n\r\nWrite routing and spoken control values through `vars` or assign explicit helper return values. Do not mutate `global route` or `global line` inside helpers: a local exec using one namespace can hide sandbox scope differences. A real practice trace advanced the product index but lost the helper's question/readback and spoke a generic missing-detail fallback. Preserve helper results explicitly and test the actual generated graph and API mappings, rather than only calling its business functions locally.\r\n\r\n\r\n\r\n## Deterministic enforcement\r\n\r\n\r\n\r\nPrefer actual code/hook guards to merely saying 'don't' in prompts. Gate get_account behind successful bank verification. Before create_promise, validate product_id, amount/floor/full, date/business/deadline, confirmed read-back for the exact current proposal and absence of a prior recorded promise for that product. Track attempt and retry limits in vars. A changed amount/date invalidates prior confirmation. Multi-product confirmation must cover the current set and each distinct date. Do not let a bare proposal count as confirmation. The dialogue can fill a boolean confirmation argument, but that alone is not a sufficient proof of a matching read-back: use node/extracted confirmation state and a stored pending proposal where practical. If a guard blocks an action, do not issue the bank write or fabricate ok:true. Fail closed using the verified platform mechanism; where stopping a hook is not verified, use a separate guarded code/API node or clearly state the enforcement limitation in coverage.\r\n\r\n\r\n\r\nA customer can propose a valid date or amount and ask whether you are a robot in the same turn. Preserve the primary payment/security event and extract independent administrative-question flags; answer the question truthfully without dropping the proposal or fabricating an answer. Distinguish an offer from a required confirmation/read-back in the actual spoken wording; reading an already accepted floor back is not another persuasion attempt.\r\n\r\n\r\n\r\nAnswer factual amount/account questions from the verified bank response when the requested fact is present, while preserving the current source-defined negotiation state and counters. Do not claim the information is unavailable merely because the utterance is a question, and do not ask the customer to invent a balance already supplied by the bank. Before verification, continue to protect debt information. A polite question can express a completed human or restructuring request; negating the requested contact in \"do not contact me again\" does not negate the stop request itself. Separate these meanings from genuine hypothetical, quoted or unfinished acts. A death report must bind to the input's relevant customer, not an unrelated relative. Normalize Unicode apostrophes for negative/withdrawal guards without losing original source-span positions; curly punctuation must not turn an explicitly negative utterance into consent even when an extractor incorrectly emits bare confirmation.\r\n\r\n\r\n\r\nGive administrative questions their source-authorized answer in the current turn while retaining independent complete security or payment information. Before verification, explaining that security protects the account does not disclose the debt; a generic promise to explain later does not answer that security-purpose question. A hypothetical question about what a relative could do does not assert that the current speaker is a relative or request a transfer. Apply the supplied third-party policy to the hypothetical answer while preserving the current verified customer's state. Do not infer a human-transfer request from an unfinished question such as \"are you a...\"; keep the uncertain question and ask for completion without a bank action.\r\n\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
