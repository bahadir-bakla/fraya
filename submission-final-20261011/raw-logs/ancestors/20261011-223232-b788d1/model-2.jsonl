al/withdrawn never writes\",\r\n    \"write_retries\": 0,\r\n    \"timeout_ms\": 25000,\r\n    \"routes\": [\r\n      \"MAIN_MENU\",\r\n      \"AGENT\",\r\n      \"IVR_LOGIN\",\r\n      \"DISCONNECT\"\r\n    ],\r\n    \"entry_verification\": \"upstream IVR\",\r\n    \"no_statement_debt_followup\": \"other card if unread, otherwise menu\",\r\n    \"annual_eligibility_flag\": \"not exposed by supplied API\"\r\n  },\r\n  \"extraction_contract\": {\r\n    \"form\": \"documented native scalar fields\",\r\n    \"fields\": [\r\n      {\r\n        \"name\": \"act\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Current caller act only: select, all_cards, yes, no, continue, done, email, past_email, alternate_email, wrong_email, paper, sms, week, fact, repeat, aside, silence, human, payment, dispute, third_party, non_turkish, complaint, out_of_scope, other_transaction, secret, private_digits, injection, withdraw, unknown. Resolve completed real assertions: third_party privacy first, human, payment, dispute, language, complaint then ordinary request. Never classify quoted, hypothetical or negated requests as asserted. Payment includes how/where to pay. Dispute includes payment not visible. A hypothetical spouse question is out_of_scope, not third_party. silence only genuinely empty/no input. Use unknown for absent intent. Current phase={{phase}}.\"\r\n      },\r\n      {\r\n        \"name\": \"completion\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Completion of the current primary act: complete or partial. Quoted/hypothetical/ambiguous source subject is partial. Cut-off corrections are partial, never consent. Example complete, partial.\"\r\n      },\r\n      {\r\n        \"name\": \"raw\",\r\n        \"type\": \"string\",\r\n        \"description\": \"The latest caller speech verbatim, once only. Do not copy conversation history or output sibling fields.\"\r\n      },\r\n      {\r\n        \"name\": \"card_reference\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Current requested card product name, exactly as spoken; empty if absent. Own available names={{card_choices}}. Do not invent a card ID or select all cards.\"\r\n      },\r\n      {\r\n        \"name\": \"card_digits\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Only currently requested identifying digits, normalized from Turkish spoken individual digits, number pairs or whole numbers to digits. Length 4, 6 or 16 only when complete; otherwise keep actual partial digits. Never invent hidden digits. Empty if not supplied.\"\r\n      },\r\n      {\r\n        \"name\": \"week\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Requested statement week: 1, 2, 3 or 4, or empty. Only an explicit week, never map a calendar day or arbitrary date into a week.\"\r\n      },\r\n      {\r\n        \"name\": \"currency\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Requested currency TL, USD, EUR or GBP, empty when absent. Currency of PDF requested or fact question, never infer from debt.\"\r\n      },\r\n      {\r\n        \"name\": \"consent\",\r\n        \"type\": \"string\",\r\n        \"description\": \"explicit only for a complete unqualified affirmative to the immediately current confirmation question, e.g. Evet, onaylıyorum. vague for Olur herhalde, maybe, probably; withdrawn for cancellation; otherwise empty. Completion of different terms or an earlier instruction to just do it is not explicit current consent.\"\r\n      },\r\n      {\r\n        \"name\": \"detail\",\r\n        \"type\": \"string\",\r\n        \"description\": \"Only requested figure: due, minimum, remaining, total, or empty. Do not request the object envelope here.\"\r\n      },\r\n      {\r\n        \"name\": \"followup\",\r\n        \"type\": \"string\",\r\n        \"description\": \"email only for a current independent request to read debt AND email the statement in the same utterance; otherwise empty. Preserve it alongside a card choice.\"\r\n      },\r\n      {\r\n        \"name\": \"admin\",\r\n        \"type\": \"string\",\r\n        \"description\": \"ai only for a complete question asking whether this assistant is a robot or AI; otherwise empty. Exact token, no substring classification.\"\r\n      }\r\n    ],\r\n    \"examples\": [\r\n      {\r\n        \"act\": \"yes\",\r\n        \"completion\": \"complete\",\r\n        \"raw\": \"Evet, onaylıyorum.\",\r\n        \"consent\": \"explicit\"\r\n      },\r\n      {\r\n        \"act\": \"yes\",\r\n        \"completion\": \"complete\",\r\n        \"raw\": \"Olur herhalde.\",\r\n        \"consent\": \"vague\"\r\n      },\r\n      {\r\n        \"act\": \"select\",\r\n        \"completion\": \"complete\",\r\n        \"raw\": \"Yıldız Premium kartımın borcunu okuyup e-posta gönderin.\",\r\n        \"card_reference\": \"Yıldız Premium\",\r\n        \"followup\": \"email\"\r\n      },\r\n      {\r\n        \"act\": \"week\",\r\n        \"completion\": \"complete\",\r\n        \"raw\": \"Üçüncü hafta.\",\r\n        \"week\": \"3\"\r\n      },\r\n      {\r\n        \"act\": \"human\",\r\n        \"completion\": \"partial\",\r\n        \"raw\": \"Bir temsilciye...\"\r\n      }\r\n    ],\r\n    \"empty_fields\": \"Absent optional fields become empty; all speech fields explicitly neutralized after use. No raw financial consent fallback.\"\r\n  },\r\n  \"platform_limitations\": \"No credentials, network calls, installs, other agents or mock deployment performed. Host performs platform tests/routing. Authorization headers omitted because supplied mock schema has no auth and no credential supplied.\"\r\n}\r\nimport json,pathlib,copy,itertools\r\nw=json.loads(pathlib.Path('workflow.json').read_text(encoding='utf-8'))\r\np=json.loads(pathlib.Path('policy.json').read_text(encoding='utf-8'))\r\nchecks=[]\r\ndef check(name,condition):\r\n    checks.append({'name':name,'passed':bool(condition)})\r\n    assert condition,name\r\ncode=w['nodes']['controller']['pre_actions'][0]['function']['parameters']['properties']['code']['default']\r\ndef run(store,reply=None,receipt=None):\r\n    if reply:store.update(reply)\r\n    if receipt:\r\n        op=store['route'];store['bank_receipt']=receipt;store['receipt_operation']=op\r\n    env={'vars':store};exec(code,env,env)\r\n    return json.loads(store['bank_state'])\r\ndef ok(d):return {'status_code':200,'data':{'result':{'returnCode':'1'},'data':d}}\r\ncard={'cardNumber':'5400001234564321','cardNumberLast4':'4321','productName':'Yıldız Premium','isMainCard':True,'status':'A'}\r\ndef initial(cards=None):\r\n    v={'customerNumber':'90000001','now':'2026-10-12T10:30:00+03:00'};run(v)\r\n    run(v,receipt=ok({'cards':cards or [card],'validCardsCount':len(cards or [card])}));return v\r\ndef block(remaining=1000,minimum=400,remaining_min=400,total=1100):\r\n    return {'statementDebt':1000,'minPayment':minimum,'remainingDebt':remaining,'remainingMinPayment':remaining_min,'totalDebt':total,'transferAmount':0,'remainAutomaticPaymentAmount':0}\r\nbalance={'statementDate':'05.10.2026','lastPayDate':'15.10.2026','nextStatementDate':'05.11.2026','nextLastPayDate':'15.11.2026','statementPaymentStatus':'HAS_DEBT','automaticPaymentFlag':'N','debtTL':block(),'debtUSD':block(0,0,0,0),'debtEUR':block(85.2,34.1,34.1,85.2),'debtGBP':block(0,0,0,0)}\r\ndef offer():\r\n    v=initial();run(v,receipt=ok(balance));run(v,receipt=ok({'communicationType':'Both','ibanEmail':'test@bank.example','ttsEmail':'test@bank.example'}));return v\r\ndef act(kind,**kwargs):return dict({'act':kind,'completion':'complete','raw':'','consent':''},**kwargs)\r\nv=offer();check('single-card-balance-before-contact',v['phase']=='offer' and 'Dolar ve İngiliz Sterlini borcunuz bulunmamaktadır.' in v['dialogue_line'])\r\nv=offer();run(v,act('email'));check('address-read-before-send',v['phase']=='email_confirm' and 'test@bank.example' in v['dialogue_line'])\r\nrun(v,act('yes',raw='Olur herhalde.',consent='ex