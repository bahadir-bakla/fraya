  "semantic_schema_checks": [
    "Unique example_id across all supplied TRAIN packets; no labels/y/expected predictions/judge output in author packet.",
    "Author IDs/template IDs/scenario IDs/record IDs are provenance only; never model features.",
    "utterance.source_turn_id equals turn_id; fictional question/targets/pending are already-spoken local state only.",
    "Pending target and question target indices must refer to declared targets; no real account/security details or policy facts.",
    "Raw offsets and UTF8 bounds must reproduce exact text in immutable packet; end>start; preserve original Unicode without cleaning or normalization.",
    "For observed primary, positive means payment_proposal is PRIMARY; negative means another known PRIMARY act. Negative says nothing about secondary payment, refusal, consent or policy. Ambiguous/unassessed => primary_observed=false.",
    "For observed completion, presence=present, completion in complete/unfinished, maximal boundary observed and target scope observed. Ambiguous/unassessed/incompatible type is masked, never coerced into unfinished.",
    "Target-scope-observed requires nonempty exact requested known target set; uncertain/current/superseded roles remain distinct. Superseded spans do not add current support.",
    "Reference verified and normalization verified require independent evidence references in a future binding extension; these schemas alone cannot verify them. Default both unassessed, no normalized value emitted.",
    "Primary surface remains masked for security phase OR security role OR nonnull question.security_field OR current unchanged sensitive-keyword/privacy predicate. Reviewer true cannot override runtime false.",
    "This narrow supplement deliberately has no offers/readback: spoken_offers empty and active_readback null. Additional reference contexts need a separately versioned schema, not hidden fields."
  ],
  "independent_review_requirements": {
    "author": "Separate fresh source author; source-only fictional inputs and lineage recipes, no labels or detector outputs supplied as author guidance.",
    "two_reviewers": "Parent verifies distinct isolated source-only reviewers, neither author; both receive every member of each full canonical closure and immutable raw packet. Do not supply model predictions, current candidate spans, old holdout answers or each other annotations.",
    "adjudicator": "Distinct source adjudicator reads original two reviews and exact source; isolated adjudication, NOT falsely called blind review. Retain every original annotation/hash and adjudicate disagreements; undecidable labels/boundaries/targets stay masked.",
    "freeze": "Freeze raw packet, full review records, adjudication decisions, source vectors, canonical registry/alias overlay and parser/boundary contract before any join or fit.",
    "full_group_review": "Every member including contextual contrasts, positive or ambiguous members must be retained and reviewed; no cherry-picked negative-only members.",
    "admission": "Existing narrow_review_v4_1 is exact-pinned to old five inputs and does not admit supplements. Parent requires NEW versioned admission and exact out-of-band hash grant binding supplement/reviews/adjudication/aliases/split declarations/detector/features/candidate vector; no reuse of current grant."
  },
  "source_neutral_alias_rules": {
    "group_id": "Opaque root IDs assigned by registry, not labels, correctness, split desirability, reviewer, source file or desired floor.",
    "union_evidence": [
      "Shared actual template skeleton/carrier recipe with fictional slots renamed",
      "Direct rewrite, augmentation, paraphrase from same source exemplar or generation recipe",
      "Context/scoped sibling/correction/permutation/quoted carrier contrast derived from one semantic scenario",
      "Duplicate utterance plus same underlying context recipe, even across authors/files/names",
      "Shared declared source/scenario family that constitutes the same construction lineage"
    ],
    "operations": "Parent freezes explicit alias edges with evidence and transitive union BEFORE labels are counted or folds assigned. Compare supplied existing TRAIN inputs/provenance to supplement source-only; future unknown edges remain unknown. Never split a previous canonical root to improve support.",
    "scope": "No new DEV or holdout contents read. Parent supplies identifier-only external split/alias declarations; cross-split alias conflicts block admission. Global registry outside supplied packets remains unknown.",
    "recount": "Canonical positive set includes every observed positive member. Additional negative support = observed negative canonical set MINUS positive canonical set after all unions and feature masks. DATE paired same root may support both classes. New source/author IDs alone never imply independent groups."
  },
  "candidate_target_and_boundary_contract": {
    "unit": "One maximal temporal expression at original half-open Unicode span; include dependent of/before/after/to/or operands or explicit open tail. R4 source fixed; child anchor is sidecar, never a second independent training example.",
    "boundary_disagreement": "Annotate original full semantic boundary independently. If actual R4 offsets differ, retain boundary_mismatch and no completion loss. No nearest span, punctuation trimming, carrier clipping, rewrite or mask override to manufacture alignment.",
    "target_join": "Exact example/source pointer/start/end/text AND exact target set. Current R4 vector provides singleton question-target hypotheses only. Multi-target spans may be annotated but remain ineligible until separately implemented/audited source target binding. Do not union targets or borrow target identities from reviewed labels into detector vector.",
    "unfinished_axis": "Genuinely open temporal complement/operand/range endpoint; missing year, vague next week, impossible calendar, negated/quoted/conditional dates and unresolved anaphors are not automatically unfinished. Linguistic completeness independent of act completion/polarity/value normalization.",
    "feature_join": "Use fixed R4 48-codepoint clause-local extractor on actual candidates. Boundary ambiguity, unsupported cross-clause dependency, window clipping, privacy/source problems and overflow mask completion loss; no label-dependent window expansion.",
    "absence": "No candidate does not establish semantic absence. Unmatched detections need independent absent-region review before validity-negative supervision; absence regions cannot overlap reviewed presence.",
    "minimum_eligibility": "New DATE root counts only if independently observed unfinished at exact actual R4 maximal boundary/current singleton target set and unchanged source/privacy/window feature eligibility. No guarantee hypothetical author expression passes parser."
  },
  "next_actions": "Separate author collects inputs; parent coordinates source-neutral closure and fresh reviews/adjudication. Designer11 resolves architecture. This implementer iteration closes; no more fit/data or GPU work.",
  "new_DEV_read": false,
  "qualified": false,
  "payment_authority": false,
  "gpu_authorized": false
}
