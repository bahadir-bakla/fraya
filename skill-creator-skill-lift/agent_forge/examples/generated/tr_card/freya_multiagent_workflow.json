          {
            "name": "dob",
            "type": "string"
          },
          {
            "name": "id_last4",
            "type": "string"
          },
          {
            "name": "intent",
            "type": "string",
            "enum": [
              "ask_info",
              "block_card",
              "none"
            ],
            "description": "Which listed situation the caller's last turn is in; none if unsure."
          }
        ]
